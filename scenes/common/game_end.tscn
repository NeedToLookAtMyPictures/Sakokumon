bbcode_enabled = true
text = "[center][color=#ffffff][font_size=60]On July 8 1853 in the Christian calendar some westerners arrived from America. They came with extremely large ships called 'gunboats', more than ten times larger than the largest warships in our history, the O-Atakebune. The Edo government banned and destroyed all Japanese ships that large, claiming that they are no longer of use now that Japan has one unified ruler. The westerners have provided assurance to the Emperor that they have no intentions to spread Christianity or religion, but they will either be permitted trade or begin attacking. This event in combination with the recent suggestion by the Dutch King have resulted in the Sakoku policy being ended. The Dutch have decided to move their operations closer to the capital, Edo, which will be renamed Tokyo soon. And so my time as a guard here comes to an end, and this island will slowly rejoin the Nagasaki waterfront.[/font_size][/color][/center]"

